{
  "task_id": "recording-quality",
  "description": "Five sessions from a robot arm recorder at 20 Hz. Before they are used for training, check that every session was recorded whole and the recorder behaved.",
  "inputs": {},
  "outputs": {},
  "checks": [
    {"name": "every session recorded", "type": "trace_count",
     "target": ["recordings/session1.jsonl", "recordings/session2.jsonl", "recordings/session3.jsonl",
                "recordings/session4.jsonl", "recordings/session5.jsonl"],
     "where": {"field": "frame", "eq": 0}, "distinct": "session", "equals": 5},
    {"name": "no dropped frames", "type": "trace_delta",
     "target": ["recordings/session1.jsonl", "recordings/session2.jsonl", "recordings/session3.jsonl",
                "recordings/session4.jsonl", "recordings/session5.jsonl"],
     "field": "frame", "equals": 1, "group_by": "session"},
    {"name": "clock steady at 20 Hz", "type": "trace_delta",
     "target": ["recordings/session1.jsonl", "recordings/session2.jsonl", "recordings/session3.jsonl",
                "recordings/session4.jsonl", "recordings/session5.jsonl"],
     "field": "t", "equals": 0.05, "tolerance": 0.001, "group_by": "session"},
    {"name": "arm never frozen for more than 2 s", "type": "trace_stall",
     "target": ["recordings/session1.jsonl", "recordings/session2.jsonl", "recordings/session3.jsonl",
                "recordings/session4.jsonl", "recordings/session5.jsonl"],
     "fields": ["joint1", "joint2", "gripper"], "max_run": 40, "group_by": "session"},
    {"name": "every session ends done", "type": "trace_final",
     "target": ["recordings/session1.jsonl", "recordings/session2.jsonl", "recordings/session3.jsonl",
                "recordings/session4.jsonl", "recordings/session5.jsonl"],
     "condition": {"field": "done", "eq": true}, "group_by": "session"},
    {"name": "joints finite and in range", "type": "trace_always",
     "target": ["recordings/session1.jsonl", "recordings/session2.jsonl", "recordings/session3.jsonl",
                "recordings/session4.jsonl", "recordings/session5.jsonl"],
     "condition": {"all": [{"field": "joint1", "ge": -180}, {"field": "joint1", "le": 180},
                           {"field": "joint2", "ge": -180}, {"field": "joint2", "le": 180},
                           {"field": "gripper", "ge": 0}, {"field": "gripper", "le": 100}]}}
  ]
}
